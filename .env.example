# SECRETS
# ---------------------------------------------------

DEPLOYMENT_PRIVATE_KEY="0x..."
ALCHEMY_API_KEY="..."
ETHERSCAN_API_KEY="..."

# DEPLOYMENT PARAMETERS
# ---------------------------------------------------

SKIP_L2=true

# Governance token base contracts (address(1) = not used)
GOVERNANCE_ERC20_BASE="0x0000000000000000000000000000000000000001"
GOVERNANCE_WRAPPED_ERC20_BASE="0x0000000000000000000000000000000000000001"

# Governance parameters
MIN_VETO_RATIO="300000" # 30% (base 1_000_000)
TIME_LOCK_PERIOD="604800" # in seconds (7 days)
L2_INACTIVITY_PERIOD="600" # in seconds (10 minutes)
L2_AGGREGATION_GRACE_PERIOD="172800" # in seconds (2 days)
MIN_STD_PROPOSAL_DURATION="1209600" # in seconds (14 days)
MIN_STD_APPROVALS="3"
MIN_EMERGENCY_APPROVALS="6"
MULTISIG_PROPOSAL_EXPIRATION_PERIOD="864000" # in seconds (10 days)

# Multisig
MULTISIG_MEMBERS_JSON_FILE_NAME="/script/multisig-members.json"

# ENS subdomains
STD_MULTISIG_ENS_DOMAIN="taiko-std-multisig"
EMERGENCY_MULTISIG_ENS_DOMAIN="taiko-emergency-multisig"
OPTIMISTIC_TOKEN_VOTING_ENS_DOMAIN="taiko-optimistic-token-voting"

# DEPLOYED ADDRESSES (filled after running scripts)
# ---------------------------------------------------

DAO_ADDRESS="0x..."
PLUGIN_ADDRESS="0x..."
PLUGIN_REPO_ADDRESS="0x..."
MULTISIG_PLUGIN_ADDRESS="0x..."

# Network-specific settings (RPC, chain ID, Taiko contracts, etc.)
# are loaded via `just switch <network>`.
